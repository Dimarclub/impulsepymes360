// Dimarclub - B2C Marketplace con sistema de afiliados de 3 niveles
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y red de afiliados ----------

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  phone      String?
  password   String   @default("dimar123")
  role       String   @default("CLIENT") // CLIENT, AFFILIATE, SUPPLIER, COURIER, PARTNER, ADMIN
  avatarUrl  String?
  city       String?
  address    String?

  // Red de afiliados (auto-referencia)
  sponsorId  String?
  sponsor    User?    @relation("Referrals", fields: [sponsorId], references: [id])
  referrals  User[]   @relation("Referrals")
  affiliateCode String?

  supplier   Supplier?
  courier    Courier?
  partner    Partner?
  orders     Order[]
  commissions Commission[]
  cart       Cart?
  socialAccounts SocialAccount[]
  socialPosts SocialPost[]
  mediaAssets MediaAsset[]
  mediaFolders MediaFolder[]
  bioPages BioPage[]
  automationRules AutomationRule[]
  provider Provider?
  notifications Notification[]
  cooperativeAccount CooperativeAccount?
  gridSpacesOwned GridSpace[]
  gridCommissions GridCommission[]
  adSpacesBought AdSpace[] @relation("AdSpaceBuyer")
  taskProgress TaskProgress?
  albumProgress AlbumProgress[]
  albumPrize    AlbumPrize?
  raffleEntries RaffleEntry[]
  cpaCompletions CpaCompletion[]
  externalPurchases ExternalPurchase[]

  // CRMHUB-inspired features
  dealsAssigned     Deal[]              @relation("DealAssignee")
  invoicesCreated   Invoice[]
  formTemplates     FormTemplate[]
  surveys           Survey[]
  reviewsReceived   Review[]
  appointmentsOwned Appointment[]
  coursesOwned      Course[]
  courseEnrollments CourseEnrollment[]
  knowledgeArticles KnowledgeArticle[]
  unifiedMessages   UnifiedMessage[]
  chatSessions      ChatSession[]
  funnels           Funnel[]
  bookingsAsUser    Booking[]          @relation("BookingUser")
  bagInvestments    BagInvestment[]
  // Dima — Robot buscador
  dimaSubscription  DimaSubscription?
  dimaStars         DimaStar[]
  appReferralsMade  AppReferral[]      @relation("ReferrerReferrals")
  appReferralsFrom  AppReferral[]      @relation("ReferredReferrals")
  popPurchases      PopPurchase[]

  // Recuperación de contraseña
  resetToken        String?
  resetTokenExpiresAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- Catálogo ----------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  color     String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Supplier {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  companyName String
  taxId       String?
  phone       String?
  address     String?
  city        String?
  category    String?   // rubro
  verified    Boolean   @default(false)
  rating      Float     @default(0)
  products    Product[]
  ads         Advertisement[]
  offers      Offer[]
  fairBooths  FairBooth[]
  rooms       Room[]
  bookings    Booking[]
  branches    SupplierBranch[]
  searchPhrases SearchPhrase[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  longDescription String?
  price         Float
  costPrice     Float    @default(0)
  compareAtPrice Float?
  stock         Int      @default(0)
  sku           String?
  imageUrl      String?
  gallery       String?  // JSON array
  tags          String?  // JSON array
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  featured      Boolean  @default(false)
  status        String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  commissionRate Float   @default(5) // % total de comisión (5% base = 1% N0 + 1% N1 + 1% N2 + 1% N3 + 1% plataforma. Excedente sobre 5% va a N0 como bono)
  isOwnBrand    Boolean  @default(false) // true = emprendimiento propio de la comunidad (mayor comisión)
  orderItems    OrderItem[]
  cartItems     CartItem[]
  socialPosts   SocialPost[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Ofertas publicitarias ----------

model Offer {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title         String   // ej: "Zapatos 2x1"
  description   String?  // detalles de la oferta
  originalPrice Float?   // precio original
  offerPrice    Float?   // precio con descuento
  discountPct   Int?     // % de descuento (ej: 50)
  imageUrl      String?  // imagen promocional subida por el proveedor
  startDate     DateTime
  endDate       DateTime
  status        String   @default("PENDING") // PENDING (enviada por proveedor), APPROVED (aprobada por admin), REJECTED, EXPIRED
  qrCode        String?  // código corto del QR generado automáticamente
  qrTargetUrl   String?  // URL a la que apunta el QR (Web Express del proveedor)
  adminNotes    String?  // notas del admin al aprobar/rechazar
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Pedidos y carrito ----------

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  subtotal      Float
  commission    Float       // comisión del marketplace
  total         Float
  status        String      @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  paymentStatus String      @default("UNPAID") // UNPAID, PAID, REFUNDED
  paymentMethod String?
  shippingAddress String?
  city          String?
  deliveryId    String?
  delivery      Delivery?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}

// ---------- Comisiones (3 niveles + N0) ----------

model Commission {
  id        String   @id @default(cuid())
  userId    String   // quien gana la comisión
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  sourceUserId String? // quién generó la venta (sin relación para evitar problemas con Turbopack)
  amount    Float
  level     Int      // 0 = venta propia/autoconsumo, 1, 2, 3 = niveles
  rate      Float    // porcentaje aplicado
  status    String   @default("PENDING") // PENDING, PAID
  createdAt DateTime @default(now())
}

// ---------- Logística y mensajería ----------

model Courier {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id])
  vehicleType   String     // MOTORCYCLE, BICYCLE, PICKUP, TRUCK, TRACTOR_TRUCK, TAXI
  vehicleModel  String?
  licensePlate  String?
  licenseNumber String?
  available     Boolean    @default(true)
  rating        Float      @default(0)
  zone          String?
  deliveries    Delivery[]
  createdAt     DateTime   @default(now())
}

model Delivery {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  courierId       String?
  courier         Courier? @relation(fields: [courierId], references: [id])
  status          String   @default("PENDING") // PENDING, ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED, FAILED
  taskType        String   @default("SOBRE") // SOBRE, EXPRESS, MICRODISTRIBUCION
  amountToCollect Float    @default(0) // monto a cobrar contra entrega (si aplica)
  pickupAddress   String?
  deliveryAddress String?
  distance        Float?
  estimatedMinutes Int?
  notes           String?
  // Firma e incidencias
  signatureName   String?  // nombre del receptor al firmar
  incidentType    String?  // DIRECCION_INCORRECTA, CLIENTE_AUSENTE, DAÑO, OTRO
  incidentDesc    String?  // descripción de la incidencia
  deliveredAt     DateTime? // cuándo se completó la entrega
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------- Socios (capital) ----------

model Partner {
  id                String                @id @default(cuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id])
  totalContribution Float                 @default(0)
  totalReturns      Float                 @default(0)
  status            String                @default("ACTIVE")
  contributions     PartnerContribution[]
  createdAt         DateTime              @default(now())
}

model PartnerContribution {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  amount    Float
  returnRate Float   @default(3) // 3% de utilidad
  monthlyReturn Float @default(0)
  status    String   @default("ACTIVE") // ACTIVE, WITHDRAWN
  date      DateTime @default(now())
}

// ---------- Espacios publicitarios ----------

model Advertisement {
  id         String    @id @default(cuid())
  title      String
  imageUrl   String
  targetUrl  String?
  placement  String    // HEADER, SIDEBAR_LEFT, SIDEBAR_RIGHT, IN_GRID, FOOTER, HERO
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     String    @default("ACTIVE")
  clicks     Int       @default(0)
  impressions Int      @default(0)
  price      Float     @default(0)
  createdAt  DateTime  @default(now())
}

// ---------- CRM ----------

model CrmContact {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  stage      String   @default("LEAD") // LEAD, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  value      Float    @default(0)
  source     String?  // WEB, REFERRAL, MARKETING, MARKETPLACE
  notes      String?
  tags       String?  // JSON
  assignedTo String?
  activities CrmActivity[]
  deals      Deal[]
  invoices   Invoice[]
  appointments Appointment[]
  unifiedMessages UnifiedMessage[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CrmActivity {
  id        String   @id @default(cuid())
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id])
  type      String   // CALL, EMAIL, MEETING, NOTE, TASK
  subject   String
  description String?
  dueDate   DateTime?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Email marketing ----------

model EmailCampaign {
  id            String    @id @default(cuid())
  name          String
  subject       String
  content       String
  template      String?   // PROMOTION, NEW_MEMBER, COMMISSION, NEWSLETTER
  audience      String    @default("ALL") // ALL, CLIENTS, AFFILIATES, SUPPLIERS, PARTNERS
  status        String    @default("DRAFT") // DRAFT, SCHEDULED, SENT
  scheduledAt   DateTime?
  sentAt        DateTime?
  recipientCount Int      @default(0)
  openCount     Int       @default(0)
  clickCount    Int       @default(0)
  createdAt     DateTime  @default(now())
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  segment   String   @default("ALL") // ALL, CLIENTS, AFFILIATES, SUPPLIERS, PARTNERS
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- Solicitudes (registro proveedores, mensajeros, socios) ----------

model Application {
  id        String   @id @default(cuid())
  type      String   // SUPPLIER, COURIER, PARTNER
  name      String
  email     String
  phone     String?
  details   String?  // JSON con datos específicos
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

// ---------- Dimarclub Social (automatización redes sociales) ----------

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String   // INSTAGRAM, FACEBOOK, TIKTOK, X, WHATSAPP, LINKEDIN, YOUTUBE, TELEGRAM, PINTEREST, THREADS
  handle       String   // @usuario
  displayName  String?
  avatarUrl    String?
  followerCount Int     @default(0)
  connected    Boolean  @default(true)
  token        String?  // mock OAuth token
  createdAt    DateTime @default(now())
  postAccounts SocialPostAccount[]
}

model SocialPost {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption      String
  mediaUrls    String?  // JSON array de URLs
  mediaType    String   @default("IMAGE") // IMAGE, VIDEO, CAROUSEL, TEXT
  productId    String?  // si el post promociona un producto
  product      Product? @relation(fields: [productId], references: [id])
  affiliateCode String? // código de afiliado para atribución
  platforms    String   @default("[]") // JSON array de SocialAccount ids seleccionadas
  status       String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  scheduledAt  DateTime?
  publishedAt  DateTime?
  // Métricas (simuladas al publicar, reales en producción)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  reach        Int      @default(0)
  clicks       Int      @default(0)
  // Atribución de ventas
  attributedOrders Int  @default(0)
  attributedRevenue Float @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     SocialPostAccount[]
}

model SocialPostAccount {
  id        String       @id @default(cuid())
  postId    String
  post      SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permalink String?      // URL de la publicación publicada
  status    String       @default("PENDING") // PENDING, PUBLISHED, FAILED
}

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String   @default("IMAGE") // IMAGE, VIDEO
  size      Int      @default(0)
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags      String?  // JSON array
  createdAt DateTime @default(now())
}

model MediaFolder {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String       @default("#0d9488")
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
}

model BioPage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  subtitle    String?
  avatarUrl   String?
  theme       String   @default("emerald") // emerald, amber, dark, minimal
  affiliateCode String?
  links       String?  // JSON array {label, url, icon, type}
  views       Int      @default(0)
  clicks      Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AutomationRule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String   // BULK_PRODUCT, RECURRING, DAILY_DIGEST
  config       String   // JSON: {categoryId, frequency, platforms, template}
  status       String   @default("ACTIVE") // ACTIVE, PAUSED
  lastRunAt    DateTime?
  postsCreated Int      @default(0)
  createdAt    DateTime @default(now())
}

// ---------- ImpulsePymes360 — Orquestador + Web Express ----------

model Plan {
  id            String   @id @default(cuid())
  name          String   // STARTER, EMPRENDEDOR, COMERCIAL, PREMIUM, ELITE, CORPORATIVO
  displayName   String
  price         Float    // precio mensual USD (Plan 1 = 0 gratis)
  description   String
  // Límites del plan
  maxWebSections Int     @default(10) // secciones Web Express
  // Servicios digitales — TODOS incluidos en TODOS los planes
  hasEmail      Boolean  @default(true)
  hasSocialStudio Boolean @default(true)
  hasAutoposter Boolean  @default(true)
  hasForms      Boolean  @default(true)
  hasSurveys    Boolean  @default(true)
  hasReviews    Boolean  @default(true)
  hasChat       Boolean  @default(true)
  hasCrm        Boolean  @default(true)
  hasAiHub      Boolean  @default(true)
  hasInbox      Boolean  @default(true)
  hasReservas   Boolean  @default(true)
  // Espacios físicos
  bagSpaces     Int      @default(67) // legacy: espacios en bolso reutilizable
  directorioInternationalSpaces Int @default(2) // espacios en directorio comercial internacional
  calendarioSpaces Int    @default(2) // espacios en calendario-directorio
  // Dima Robot — frases de posicionamiento incluidas en el plan
  dimaPhrases   Int      @default(5) // # de frases para el robot Dima incluidas (5/10/15/30/35/40)
  // Marketplace
  maxProducts   Int      @default(999999) // sin límite en nuevos planes
  maxAffiliateRate Float @default(3)  // % máximo comisión marketplace (1% N1 + 1% N2 + 1% N3 = 3%)
  // Legacy (mantenidos por compat)
  maxAdSpaces   Int      @default(0)  // espacios PubliBags (deprecado, usar bagSpaces)
  hasWebExpress Boolean  @default(true)
  hasDirectorio Boolean  @default(true)
  hasLogistica  Boolean  @default(false) // mensajería eliminada de planes
  hasSocial     Boolean  @default(true)
  featured      Boolean  @default(false)
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
}

// ---------- Inversión en Bolsos PubliBags (5% mensual compuesto) ----------

model BagInvestment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comboQuantity Int      @default(1) // # de combos comprados (cada combo = $44)
  amount        Float    // monto invertido en USD
  monthlyRate   Float    @default(0.05) // 5% mensual
  // Estado del interés compuesto
  currentBalance Float   @default(0) // balance acumulado con interés compuesto
  lastCompoundAt DateTime? // última vez que se aplicó interés compuesto
  totalEarned   Float    @default(0) // total de interés ganado hasta ahora
  // Referencia al pedido que generó la inversión
  orderId       String?
  status        String   @default("ACTIVE") // ACTIVE, WITHDRAWN, CANCELLED
  // Historial de aplicación del interés (1 entrada por mes)
  compoundings   BagCompoundEntry[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BagCompoundEntry {
  id            String   @id @default(cuid())
  investmentId  String
  investment    BagInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  periodStart   DateTime // inicio del mes
  periodEnd     DateTime // fin del mes
  startingBalance Float
  interestEarned Float
  endingBalance  Float
  appliedAt     DateTime @default(now())
}

model Provider {
  id            String   @id @default(cuid())
  userId        String   @unique  // → User (quien administra el proveedor)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  taxId         String?
  phone         String?
  mobile        String?
  address       String?
  city          String?
  category      String?
  description   String?
  logoUrl       String?
  coverUrl      String?
  websiteSlug   String   @unique  // para Web Express: /[slug]
  // Configuración del plan de afiliados
  affiliateRate Float    @default(2) // % que este proveedor ofrece a la red de afiliados
  // Estado
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELLED
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscription  Subscription?
  website       WebsiteExpress?
  qrCodes       QRCode[]
  adSpaces      AdSpace[]
  directoryEntry DirectoryEntry?
}

model Subscription {
  id            String   @id @default(cuid())
  providerId    String   @unique
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  status        String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  startDate     DateTime @default(now())
  endDate       DateTime? // null = activa indefinidamente
  amount        Float    // monto mensual
  paymentMethod String?
  // Renovación
  nextBillingDate DateTime?
  createdAt     DateTime @default(now())
}

model WebsiteExpress {
  id            String   @id @default(cuid())
  providerId    String   @unique
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slug          String   @unique
  // Configuración visual
  template      String   @default("classic") // classic, modern, minimal, vibrant
  primaryColor  String   @default("#0d9488")
  accentColor   String   @default("#d97706")
  // Contenido editable
  heroTitle     String?
  heroSubtitle  String?
  heroImageUrl  String?
  heroVideoUrl  String?  // URL de YouTube para el video de presentación del proveedor
  aboutText     String?
  contactEmail  String?
  contactPhone  String?
  contactWhatsapp String?
  contactAddress String?
  // Horarios (JSON: {mon: "9-18", ...})
  businessHours String?
  // Redes sociales
  socialLinks   String?  // JSON {instagram, facebook, tiktok, ...}
  // Productos destacados en el sitio (JSON array de productIds)
  featuredProducts String?
  // SEO
  metaTitle     String?
  metaDescription String?
  // Estado
  published     Boolean  @default(true)
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QRCode {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  code          String   @unique  // código corto ej: ABC123
  targetUrl     String   // URL a la que apunta el QR
  type          String   @default("WEBSITE") // WEBSITE, PRODUCT, PROMO, DIRECTORY
  // Métricas
  scans         Int      @default(0)
  uniqueScans   Int      @default(0)
  lastScanAt    DateTime?
  // Asignación a espacio PubliBags (inversa, sin references)
  adSpaceId     String?
  adSpace       AdSpace?
  // Metadata de escaneos (JSON array: [{date, ip, location, device}])
  scanLogs      String?
  createdAt     DateTime @default(now())
}

model AdEdition {
  id            String   @id @default(cuid())
  name          String   // Ej: "Edición Octubre 2025 - Guayaquil"
  slug          String   @unique
  city          String
  totalSpaces   Int      @default(80)  // espacios 5x5cm por bolsa
  bagSize       String   @default("48x48") // tamaño de la bolsa
  printQuantity Int      @default(500) // cantidad de bolsas a imprimir
  startDate     DateTime
  endDate       DateTime
  status        String   @default("DRAFT") // DRAFT, OPEN, CLOSED, PRINTED
  adSpaces      AdSpace[]
  createdAt     DateTime @default(now())
}

model AdSpace {
  id            String   @id @default(cuid())
  editionId     String
  edition       AdEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  providerId    String?
  provider      Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  buyerId       String?  // usuario que compró el espacio (socio) — links to User
  buyer         User?    @relation("AdSpaceBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName     String?  // nombre del comprador (denormalizado para la edición impresa)
  position      Int      // número de espacio (1-297 para bolso)
  type          String   @default("QR") // QR, IMAGE, LOGO
  imageUrl      String?  // si es IMAGE o LOGO
  qrCodeId      String?  @unique
  qrCode        QRCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  status        String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  price         Float    @default(20)
  reservedAt    DateTime?
  soldAt        DateTime?
  createdAt     DateTime @default(now())
}

// ---------- Site Settings + Banners ----------

model SiteSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  updatedAt     DateTime @updatedAt
}

model Banner {
  id            String   @id @default(cuid())
  title         String
  imageUrl      String?
  videoUrl      String?
  gifUrl        String?
  linkUrl       String?
  placement     String   @default("HOME_MAIN")
  width         Int      @default(1320)
  height        Int      @default(330)
  active        Boolean  @default(true)
  order         Int      @default(0)
  startDate     DateTime @default(now())
  endDate       DateTime?
  clicks        Int      @default(0)
  impressions   Int      @default(0)
  createdAt     DateTime @default(now())
}

model BrandLogo {
  id            String   @id @default(cuid())
  name          String
  logoUrl       String
  linkUrl       String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

// ---------- Cooperativa de Ahorro y Crédito ----------

model CooperativeAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Float    @default(0)
  totalContributed Float   @default(0)
  totalEarned     Float    @default(0)
  totalWithdrawn  Float    @default(0)
  interestRate    Float    @default(5)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  transactions    CooperativeTransaction[]
}

model CooperativeTransaction {
  id              String   @id @default(cuid())
  accountId       String
  account         CooperativeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type            String   // DEPOSIT, INTEREST, COMMISSION_MARKETPLACE, COMMISSION_GRID, WITHDRAWAL, MATERIAL
  amount          Float
  description     String?
  // Para materiales reciclados
  materialType    String?  // ALUMINUM, COPPER, BOTTLE_SMALL, BOTTLE_LARGE
  materialQuantity Float?  // libras o unidades
  materialUnitPrice Float? // precio por unidad
  // Para vincular con grid/orden
  referenceId     String?  // gridSpaceId, orderId, etc.
  status          String   @default("COMPLETED") // COMPLETED, PENDING
  createdAt       DateTime @default(now())
}

model MaterialPrice {
  id              String   @id @default(cuid())
  materialType    String   @unique // ALUMINUM, COPPER, BOTTLE_SMALL, BOTTLE_LARGE
  name            String
  unitPrice       Float
  unit            String   @default("libra") // libra, unidad
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model MaterialInventory {
  id              String   @id @default(cuid())
  materialType    String
  quantity        Float    @default(0)
  unit            String   @default("libra")
  // Para vidrio: se guarda para Reciclarte
  // Para aluminio/cobre: se vende
  location        String?  // bodega
  notes           String?
  updatedAt       DateTime @updatedAt
}

model FinancialReport {
  id              String   @id @default(cuid())
  period          String   // "2025-01" mensual o "2025" anual
  type            String   @default("MONTHLY") // MONTHLY, ANNUAL
  totalIncome     Float    @default(0)
  totalExpenses   Float    @default(0)
  totalCommissionsPaid Float @default(0)
  totalInterestPaid Float  @default(0)
  totalMaterialSales Float @default(0)
  totalArtisanSales Float  @default(0)
  netProfit       Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  message       String
  link          String?
  metadata      String?
  read          Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())
}

// ---------- Grid Publicitario (PubliBags Digital) ----------

model GridCampaign {
  id          String   @id @default(cuid())
  name        String
  year        Int
  status      String   @default("ACTIVE")
  pages       GridPage[]
  createdAt   DateTime @default(now())
}

model GridPage {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    GridCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  month       Int
  monthName   String
  totalSpaces Int      @default(300)
  spaces      GridSpace[]
  createdAt   DateTime @default(now())
}

model GridSpace {
  id            String   @id @default(cuid())
  pageId        String
  page          GridPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  position      Int
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  buyerName     String?
  buyerEmail    String?
  buyerPhone    String?
  qrCode        String?
  qrUrl         String?
  purchasePrice Float    @default(20)
  salePrice     Float?
  status        String   @default("AVAILABLE")
  ownedAt       DateTime?
  soldAt        DateTime?
  soldBy        String?
  reimbursedToOwner Boolean @default(false)
  imageUrl      String?
  websiteSlug   String?
  commissions   GridCommission[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GridCommission {
  id            String   @id @default(cuid())
  spaceId       String
  space         GridSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         Int
  amount        Float    @default(1)
  rate          Float    @default(5)
  status        String   @default("PENDING")
  sourceUserId  String?
  createdAt     DateTime @default(now())
}

model TaskProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanDone      Boolean  @default(false)
  identifyDone  Boolean  @default(false)
  visitWebDone  Boolean  @default(false)
  shareDone     Boolean  @default(false)
  commentDone   Boolean  @default(false)
  photoDone     Boolean  @default(false)
  photoUrl      String?
  completed     Boolean  @default(false)
  completedAt   DateTime?
  rewardClaimed Boolean  @default(false)
  rewardClaimedAt DateTime?
  identifiedCompany String?
  shareUrl      String?
  commentText   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Directorio360 + Álbum de Stickers ----------

model DirectoryEntry {
  id            String   @id @default(cuid())
  providerId    String   @unique
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category      String
  tags          String?
  shortDesc     String?
  featured      Boolean  @default(false)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  viewCount     Int      @default(0)
  visitCount    Int      @default(0)
  status        String   @default("ACTIVE")
  stickers      Sticker[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Sticker {
  id            String   @id @default(cuid())
  directoryEntryId String
  directoryEntry DirectoryEntry @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)
  name          String
  imageUrl      String
  code          String   @unique
  rarity        String   @default("COMMON")
  // Cromo según el plan del proveedor
  planLevel     Int      @default(1) // 1=$67, 2=$122, 3=$253, 4=$363, 5=$478, 6=$592+
  stickerSize   String   @default("8x2") // "8x2", "8x4", "4x4", "14x4", "24x4"
  hasQR         Boolean  @default(false)
  hasLogo       Boolean  @default(false)
  hasBanner     Boolean  @default(false)
  bannerType    String?  // "horizontal", "vertical", null
  hasMarketplaceAd Boolean @default(false) // plan $592+ incluye espacio publicitario en marketplace
  qrCode        String?  // código QR del cromo (para escanear al reclamarlo)
  qrTargetUrl   String?  // URL a la que apunta el QR
  albumProgress  AlbumProgress[]
  createdAt     DateTime @default(now())
}

model AlbumProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerId     String
  sticker       Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  source        String   @default("QR_SCAN") // QR_SCAN, STORE_VISIT, ADMIN_ASSIGN
  collectedAt   DateTime @default(now())
  @@unique([userId, stickerId])
}

// Premio por llenar el álbum
model AlbumPrize {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalStickers Int      @default(0) // total de cromos disponibles
  collectedStickers Int  @default(0) // cromos recolectados
  completed     Boolean  @default(false)
  completedAt   DateTime?
  prizeAmount   Float    @default(200) // $200 al llenar el álbum
  prizeClaimed  Boolean  @default(false)
  prizeClaimedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Raffle {
  id            String   @id @default(cuid())
  name          String
  description   String?
  prize         String
  prizeImageUrl String?
  drawDate      DateTime
  status        String   @default("ACTIVE")
  minStickers   Int      @default(10)
  entries       RaffleEntry[]
  createdAt     DateTime @default(now())
}

model RaffleEntry {
  id            String   @id @default(cuid())
  raffleId      String
  raffle        Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       Int      @default(1)
  winner        Boolean  @default(false)
  enteredAt     DateTime @default(now())
  @@unique([raffleId, userId])
}

// ---------- Tareas CPA (Cost-Per-Action) ----------

model CpaTask {
  id                String   @id @default(cuid())
  title             String
  description       String?
  type              String   @default("VIDEO") // VIDEO, SHARE, VISIT, SUBSCRIBE, PHOTO_BOLSO, PHOTO_STORE, PHOTO_STICKER, PURCHASE_REGISTER, MONTHLY_STICKERS
  videoUrl          String?
  imageUrl          String?
  offerTitle        String?
  offerUrl          String?
  productId         String?
  commission        Float    @default(0.15)
  maxParticipants   Int?
  currentParticipants Int @default(0)
  startDate         DateTime @default(now())
  endDate           DateTime
  status            String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, EXPIRED
  createdBy         String
  requiresMonthlyConsumption Boolean @default(false) // true = requiere $250/mes para reclamar
  createdAt         DateTime @default(now())
  completions       CpaCompletion[]
}

model CpaCompletion {
  id            String   @id @default(cuid())
  taskId        String
  task          CpaTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String   @default("COMPLETED") // COMPLETED, PENDING_REVIEW, REJECTED
  photoUrl      String?
  rewardAmount  Float
  videoWatched  Boolean  @default(false)
  shared        Boolean  @default(false)
  purchased     Boolean  @default(false)
  strikeCount   Int      @default(0)
  reviewedAt    DateTime?
  reviewedBy    String?
  adminNotes    String?
  completedAt   DateTime @default(now())
  completionDate String?  // fecha del día en formato YYYY-MM-DD (para validar 1 vez por día)
  @@unique([taskId, userId, completionDate])
}

// ---------- Registro de compras externas (CPA) ----------

model ExternalPurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productName   String
  amount        Float
  storeName     String?  // tienda donde compró
  storeUrl      String?  // URL de la tienda (si es online)
  receiptUrl    String?  // foto del recibo/factura
  category      String?  // categoría del producto
  status        String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  rewardAmount  Float    @default(0) // No se paga comisión por registrar — el usuario ya cobra 3% N0
  reviewedAt    DateTime?
  reviewedBy    String?
  adminNotes    String?
  createdAt     DateTime @default(now())
}

// ---------- Ferias (Calendario de Ferias) ----------

model Fair {
  id          String   @id @default(cuid())
  name        String   // ej: "Feria de Emprendedores Guayaquil"
  description String?
  location    String?  // dirección
  city        String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  booths      FairBooth[]
  createdAt   DateTime @default(now())
}

model FairBooth {
  id          String   @id @default(cuid())
  fairId      String
  fair        Fair     @relation(fields: [fairId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  boothNumber String?  // ej: "Stand A-12"
  status      String   @default("AVAILABLE") // AVAILABLE, RESERVED, CONFIRMED
  createdAt   DateTime @default(now())
}

// =====================================================================
// CRMHUB-inspired modules
// =====================================================================

// ---------- Embudos de Venta (Sales Funnels) ----------

model Funnel {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  stages      FunnelStage[]
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FunnelStage {
  id          String   @id @default(cuid())
  funnelId    String
  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  color       String?
  deals       Deal[]
}

model Deal {
  id          String   @id @default(cuid())
  funnelId    String
  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stageId     String
  stage       FunnelStage @relation(fields: [stageId], references: [id])
  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  title       String
  value       Float    @default(0)
  currency    String   @default("USD")
  probability Int      @default(0)
  expectedCloseDate DateTime?
  assignedToId String?
  assignedTo  User?    @relation("DealAssignee", fields: [assignedToId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Facturación + Enlaces de Pago ----------

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  issuer      User     @relation(fields: [userId], references: [id])
  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  clientName  String?
  clientEmail String?
  clientPhone String?
  items       String   @default("[]") // JSON array
  subtotal    Float    @default(0)
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  currency    String   @default("USD")
  status      String   @default("DRAFT") // DRAFT, SENT, PAID, VOID, OVERDUE
  paymentLink String?
  notes       String?
  paidAt      DateTime?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Centro de IA + Base de Conocimiento ----------

model KnowledgeArticle {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  content     String
  category    String?
  tags        String?  // comma-separated
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Formularios + Respuestas ----------

model FormTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  fields      String   @default("[]") // JSON array
  submitLabel String   @default("Enviar")
  successMessage String?
  responses   FormResponse[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  form        FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)
  data        String   @default("{}") // JSON
  contactId   String?
  createdAt   DateTime @default(now())
}

// ---------- Encuestas ----------

model Survey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  questions   String   @default("[]") // JSON array
  responses   SurveyResponse[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentName String?
  respondentEmail String?
  answers     String   @default("{}") // JSON
  rating      Int?
  createdAt   DateTime @default(now())
}

// ---------- Reseñas (Reputation) ----------

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  customerName String
  customerEmail String?
  rating      Int      // 1-5
  title       String?
  comment     String?
  source      String   @default("INTERNAL") // INTERNAL, GOOGLE, FACEBOOK
  status      String   @default("PUBLISHED") // PUBLISHED, HIDDEN, PENDING
  response    String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
}

// ---------- Citas / Calendario ----------

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  clientName  String
  clientEmail String?
  clientPhone String?
  service     String
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Cursos / Membresías ----------

model Course {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  coverImage  String?
  category    String?
  lessons     CourseLesson[]
  enrollments CourseEnrollment[]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseLesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  content     String
  videoUrl    String?
  duration    Int?
  order       Int      @default(0)
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  progress    Int      @default(0)
  completedLessons String @default("[]") // JSON array of lesson ids
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  @@unique([courseId, userId])
}

// ---------- Reservas (Hoteles / Autos / Tours / Equipos) ----------

model Room {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name          String   // "Habitación Doble", "Toyota Yaris", "Tour Manglares", "Taladro Bosch"
  type          String   // HOTEL_ROOM, CAR, TOUR, EQUIPMENT
  description   String?
  capacity      Int      @default(2)  // # personas o cupos
  pricePerNight Float    // precio por unidad de tiempo (noche/día/tour)
  currency      String   @default("USD")
  quantity      Int      @default(1)  // cuántas unidades de este recurso existen
  amenities     String?  // JSON array: ["wifi","desayuno","ac"]
  imageUrl      String?
  gallery       String?  // JSON array
  address       String?
  city          String?
  isActive      Boolean  @default(true)
  bookings      Booking[]
  availability  RoomAvailability[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date        DateTime // día específico (sin hora, medianoche UTC)
  available   Int      // cupos disponibles ese día
  @@unique([roomId, date])
}

model Booking {
  id            String   @id @default(cuid())
  bookingCode   String   @unique // "RES-XXXXXX" para QR y búsqueda
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  userId        String?  // cliente registrado (nullable para reservas públicas sin cuenta)
  user          User?    @relation("BookingUser", fields: [userId], references: [id])
  guestName     String
  guestEmail    String
  guestPhone    String
  checkIn       DateTime
  checkOut      DateTime
  nights        Int      // # de noches / días / tours
  guests        Int      @default(1)
  quantity      Int      @default(1) // # de unidades reservadas (ej: 2 habitaciones)
  unitPrice     Float    // precio por noche guardado al momento de reservar
  subtotal      Float
  serviceFee    Float    @default(0)
  total         Float
  currency      String   @default("USD")
  status        String   @default("PENDING") // PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW, REJECTED
  paymentStatus String   @default("UNPAID") // UNPAID, DEPOSIT, PAID, REFUNDED
  paymentMethod String?
  qrCode        String?  // código corto para escaneo en check-in
  notes         String?
  affiliateCode String?  // para atribuir comisión al afiliado
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Bandeja Unificada (Multi-canal) ----------

model UnifiedMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  channel     String   // WHATSAPP, INSTAGRAM, FACEBOOK, EMAIL, SMS, WEB
  fromName    String
  fromHandle  String?
  toName      String?
  subject     String?
  body        String
  attachments String?  // JSON array
  status      String   @default("UNREAD") // UNREAD, READ, REPLIED, ARCHIVED
  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  isOutgoing  Boolean  @default(false)
  parentMessageId String?
  createdAt   DateTime @default(now())
}

// ---------- Chat en Vivo ----------

model ChatSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  visitorName String
  visitorEmail String?
  visitorIp   String?
  status      String   @default("ACTIVE") // ACTIVE, CLOSED, WAITING
  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender      String   // VISITOR, AGENT, BOT
  body        String
  createdAt   DateTime @default(now())
}

// =====================================================================
// DIMA — Robot buscador con voz asistido por IA
// =====================================================================

// ---------- Suscripción Dima Plus ($20/mes = inversión al 5% compuesto) ----------

model DimaSubscription {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   @default("PLUS") // FREE, PLUS
  pricePerMonth Float    @default(20) // $20/mes PLUS
  billingCycle  String   @default("MONTHLY") // MONTHLY, ANNUAL
  status        String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  // Inversión del pago mensual (5% compuesto)
  investedAmount Float  @default(0) // total acumulado de los pagos
  currentBalance Float @default(0) // balance con interés compuesto
  totalEarned   Float    @default(0) // interés total ganado
  lastCompoundAt DateTime?
  // Fechas
  startedAt    DateTime @default(now())
  currentPeriodEnd DateTime? // fecha del próximo cobro
  cancelledAt  DateTime?
  // Referido que trajo a este usuario
  referredBy   String?  // userId del patrocinador (N1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Frases de posicionamiento para Dima ($1/mes c/u) ----------

model SearchPhrase {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  phrase        String   // ej: "distribuidores mayoristas de bazar y papelería"
  category      String?  // categoría asociada (ej: BAZAR, PAPELERIA)
  isPremium     Boolean  @default(false) // frase destacada
  status        String   @default("ACTIVE") // ACTIVE, PAUSED (si no paga)
  monthlyPrice  Float    @default(1) // $1/mes
  paidUntil     DateTime? // hasta cuándo está paga
  searchCount   Int      @default(0) // # de veces que matcheó en búsquedas
  clickCount    Int      @default(0) // # de veces que el usuario hizo click
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Sucursales del proveedor (multi-ubicación) ----------

model SupplierBranch {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name          String   // ej: "Sucursal Centro", "Matriz Quito Norte"
  city          String
  sector        String?  // ej: "Centro", "Norte", "Sur"
  address       String
  phone         String?
  whatsapp      String?
  latitude      Float?
  longitude     Float?
  hours         String?  // horario de atención
  isMain        Boolean  @default(false) // sucursal principal
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Compra de material POP (inversión 5% compuesto) ----------

model PopPurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float    // monto de la compra (libre)
  items         String   @default("[]") // JSON: [{type: "BOLSO", quantity: 10, unitPrice: 2.5}, ...]
  // Inversión
  monthlyRate   Float    @default(0.05) // 5% mensual
  currentBalance Float   @default(0) // balance con interés compuesto
  totalEarned   Float    @default(0) // interés ganado
  lastCompoundAt DateTime?
  // QR tracking
  qrCode        String?  // código del QR unificado de Dima
  scanCount     Int      @default(0) // # de veces que escanearon su QR
  downloadCount Int      @default(0) // # de descargas de la app atribuidas
  // Estado
  status        String   @default("ACTIVE") // ACTIVE, WITHDRAWN
  orderId       String?  // referencia al pedido que generó la compra
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Dima Stars (rankings + cashback) ----------

model DimaStar {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int      @default(1) // estrellas otorgadas (normalmente 1)
  reason        String   // PURCHASE, SEARCH, REFERRAL, TOP_MONTH
  referenceId   String?  // orderId o referralId
  createdAt     DateTime @default(now())
}

// ---------- Referidos de la app Dima (comisiones N1/N2/N3) ----------

model AppReferral {
  id            String   @id @default(cuid())
  // Quién refiere
  referrerId    String
  referrer      User     @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  // Quién fue referido
  referredId    String   @unique
  referred      User     @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)
  // Nivel en la red (1 = directo, 2 = subreferido, 3 = sub-subreferido)
  level         Int      // 1, 2, 3
  // Comisiones
  signupCommission Float @default(0) // $5 (N1), $2 (N2), $1 (N3)
  monthlyCommission Float @default(0) // $2 (N1), $1 (N2), $0.50 (N3)
  totalEarned   Float    @default(0) // total acumulado de comisiones
  lastPaidAt   DateTime? // última vez que se pagó la comisión mensual
  // Estado
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE (si el referido deja de pagar)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

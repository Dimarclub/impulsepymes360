// Dimarclub - B2C Marketplace con sistema de afiliados de 3 niveles
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y red de afiliados ----------

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  phone      String?
  password   String   @default("dimar123")
  role       String   @default("CLIENT") // CLIENT, AFFILIATE, SUPPLIER, COURIER, PARTNER, ADMIN
  avatarUrl  String?
  city       String?
  address    String?

  // Red de afiliados (auto-referencia)
  sponsorId  String?
  sponsor    User?    @relation("Referrals", fields: [sponsorId], references: [id])
  referrals  User[]   @relation("Referrals")
  affiliateCode String?

  supplier   Supplier?
  courier    Courier?
  partner    Partner?
  orders     Order[]
  commissions Commission[]
  cart       Cart?
  socialAccounts SocialAccount[]
  socialPosts SocialPost[]
  mediaAssets MediaAsset[]
  mediaFolders MediaFolder[]
  bioPages BioPage[]
  automationRules AutomationRule[]
  provider Provider?
  notifications Notification[]
  cooperativeAccount CooperativeAccount?
  gridSpacesOwned GridSpace[]
  gridCommissions GridCommission[]
  adSpacesBought AdSpace[] @relation("AdSpaceBuyer")
  taskProgress TaskProgress?
  albumProgress AlbumProgress[]
  raffleEntries RaffleEntry[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- Catálogo ----------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  color     String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Supplier {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  companyName String
  taxId       String?
  phone       String?
  address     String?
  city        String?
  category    String?   // rubro
  verified    Boolean   @default(false)
  rating      Float     @default(0)
  products    Product[]
  ads         Advertisement[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  longDescription String?
  price         Float
  costPrice     Float    @default(0)
  compareAtPrice Float?
  stock         Int      @default(0)
  sku           String?
  imageUrl      String?
  gallery       String?  // JSON array
  tags          String?  // JSON array
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  featured      Boolean  @default(false)
  status        String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  orderItems    OrderItem[]
  cartItems     CartItem[]
  socialPosts   SocialPost[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Pedidos y carrito ----------

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  subtotal      Float
  commission    Float       // comisión del marketplace
  total         Float
  status        String      @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  paymentStatus String      @default("UNPAID") // UNPAID, PAID, REFUNDED
  paymentMethod String?
  shippingAddress String?
  city          String?
  deliveryId    String?
  delivery      Delivery?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}

// ---------- Comisiones (3 niveles + N0) ----------

model Commission {
  id        String   @id @default(cuid())
  userId    String   // quien gana la comisión
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  sourceUserId String? // quién generó la venta (sin relación para evitar problemas con Turbopack)
  amount    Float
  level     Int      // 0 = venta propia/autoconsumo, 1, 2, 3 = niveles
  rate      Float    // porcentaje aplicado
  status    String   @default("PENDING") // PENDING, PAID
  createdAt DateTime @default(now())
}

// ---------- Logística y mensajería ----------

model Courier {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id])
  vehicleType   String     // MOTORCYCLE, BICYCLE, PICKUP, TRUCK, TRACTOR_TRUCK, TAXI
  vehicleModel  String?
  licensePlate  String?
  licenseNumber String?
  available     Boolean    @default(true)
  rating        Float      @default(0)
  zone          String?
  deliveries    Delivery[]
  createdAt     DateTime   @default(now())
}

model Delivery {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  courierId       String?
  courier         Courier? @relation(fields: [courierId], references: [id])
  status          String   @default("ASSIGNED") // ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED
  pickupAddress   String?
  deliveryAddress String?
  distance        Float?
  estimatedMinutes Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------- Socios (capital) ----------

model Partner {
  id                String                @id @default(cuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id])
  totalContribution Float                 @default(0)
  totalReturns      Float                 @default(0)
  status            String                @default("ACTIVE")
  contributions     PartnerContribution[]
  createdAt         DateTime              @default(now())
}

model PartnerContribution {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  amount    Float
  returnRate Float   @default(3) // 3% de utilidad
  monthlyReturn Float @default(0)
  status    String   @default("ACTIVE") // ACTIVE, WITHDRAWN
  date      DateTime @default(now())
}

// ---------- Espacios publicitarios ----------

model Advertisement {
  id         String    @id @default(cuid())
  title      String
  imageUrl   String
  targetUrl  String?
  placement  String    // HEADER, SIDEBAR_LEFT, SIDEBAR_RIGHT, IN_GRID, FOOTER, HERO
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     String    @default("ACTIVE")
  clicks     Int       @default(0)
  impressions Int      @default(0)
  price      Float     @default(0)
  createdAt  DateTime  @default(now())
}

// ---------- CRM ----------

model CrmContact {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  stage      String   @default("LEAD") // LEAD, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  value      Float    @default(0)
  source     String?  // WEB, REFERRAL, MARKETING, MARKETPLACE
  notes      String?
  tags       String?  // JSON
  assignedTo String?
  activities CrmActivity[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CrmActivity {
  id        String   @id @default(cuid())
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id])
  type      String   // CALL, EMAIL, MEETING, NOTE, TASK
  subject   String
  description String?
  dueDate   DateTime?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Email marketing ----------

model EmailCampaign {
  id            String    @id @default(cuid())
  name          String
  subject       String
  content       String
  template      String?   // PROMOTION, NEW_MEMBER, COMMISSION, NEWSLETTER
  audience      String    @default("ALL") // ALL, CLIENTS, AFFILIATES, SUPPLIERS, PARTNERS
  status        String    @default("DRAFT") // DRAFT, SCHEDULED, SENT
  scheduledAt   DateTime?
  sentAt        DateTime?
  recipientCount Int      @default(0)
  openCount     Int       @default(0)
  clickCount    Int       @default(0)
  createdAt     DateTime  @default(now())
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  segment   String   @default("ALL") // ALL, CLIENTS, AFFILIATES, SUPPLIERS, PARTNERS
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- Solicitudes (registro proveedores, mensajeros, socios) ----------

model Application {
  id        String   @id @default(cuid())
  type      String   // SUPPLIER, COURIER, PARTNER
  name      String
  email     String
  phone     String?
  details   String?  // JSON con datos específicos
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

// ---------- Dimarclub Social (automatización redes sociales) ----------

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String   // INSTAGRAM, FACEBOOK, TIKTOK, X, WHATSAPP, LINKEDIN, YOUTUBE, TELEGRAM, PINTEREST, THREADS
  handle       String   // @usuario
  displayName  String?
  avatarUrl    String?
  followerCount Int     @default(0)
  connected    Boolean  @default(true)
  token        String?  // mock OAuth token
  createdAt    DateTime @default(now())
  postAccounts SocialPostAccount[]
}

model SocialPost {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption      String
  mediaUrls    String?  // JSON array de URLs
  mediaType    String   @default("IMAGE") // IMAGE, VIDEO, CAROUSEL, TEXT
  productId    String?  // si el post promociona un producto
  product      Product? @relation(fields: [productId], references: [id])
  affiliateCode String? // código de afiliado para atribución
  platforms    String   @default("[]") // JSON array de SocialAccount ids seleccionadas
  status       String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  scheduledAt  DateTime?
  publishedAt  DateTime?
  // Métricas (simuladas al publicar, reales en producción)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  reach        Int      @default(0)
  clicks       Int      @default(0)
  // Atribución de ventas
  attributedOrders Int  @default(0)
  attributedRevenue Float @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     SocialPostAccount[]
}

model SocialPostAccount {
  id        String       @id @default(cuid())
  postId    String
  post      SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permalink String?      // URL de la publicación publicada
  status    String       @default("PENDING") // PENDING, PUBLISHED, FAILED
}

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String   @default("IMAGE") // IMAGE, VIDEO
  size      Int      @default(0)
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags      String?  // JSON array
  createdAt DateTime @default(now())
}

model MediaFolder {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String       @default("#0d9488")
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
}

model BioPage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  subtitle    String?
  avatarUrl   String?
  theme       String   @default("emerald") // emerald, amber, dark, minimal
  affiliateCode String?
  links       String?  // JSON array {label, url, icon, type}
  views       Int      @default(0)
  clicks      Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AutomationRule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String   // BULK_PRODUCT, RECURRING, DAILY_DIGEST
  config       String   // JSON: {categoryId, frequency, platforms, template}
  status       String   @default("ACTIVE") // ACTIVE, PAUSED
  lastRunAt    DateTime?
  postsCreated Int      @default(0)
  createdAt    DateTime @default(now())
}

// ---------- ImpulsePymes360 — Orquestador + Web Express ----------

model Plan {
  id            String   @id @default(cuid())
  name          String   // STARTER, CRECIMIENTO, PREMIUM, ENTERPRISE
  displayName   String
  price         Float    // precio mensual USD
  description   String
  // Límites del plan
  maxProducts   Int      @default(10)
  maxAdSpaces   Int      @default(1)  // espacios PubliBags
  maxShipments  Int      @default(5)  // envíos Fuerza Delta por mes
  maxAffiliateRate Float @default(1)  // % máximo que el proveedor puede ofrecer a afiliados
  hasWebExpress Boolean  @default(true)
  hasDirectorio Boolean  @default(true)
  hasLogistica  Boolean  @default(true)
  hasSocial     Boolean  @default(false)
  featured      Boolean  @default(false)
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
}

model Provider {
  id            String   @id @default(cuid())
  userId        String   @unique  // → User (quien administra el proveedor)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  taxId         String?
  phone         String?
  mobile        String?
  address       String?
  city          String?
  category      String?
  description   String?
  logoUrl       String?
  coverUrl      String?
  websiteSlug   String   @unique  // para Web Express: /[slug]
  // Configuración del plan de afiliados
  affiliateRate Float    @default(2) // % que este proveedor ofrece a la red de afiliados
  // Estado
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELLED
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscription  Subscription?
  website       WebsiteExpress?
  qrCodes       QRCode[]
  adSpaces      AdSpace[]
  directoryEntry DirectoryEntry?
}

model Subscription {
  id            String   @id @default(cuid())
  providerId    String   @unique
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  status        String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  startDate     DateTime @default(now())
  endDate       DateTime? // null = activa indefinidamente
  amount        Float    // monto mensual
  paymentMethod String?
  // Renovación
  nextBillingDate DateTime?
  createdAt     DateTime @default(now())
}

model WebsiteExpress {
  id            String   @id @default(cuid())
  providerId    String   @unique
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slug          String   @unique
  // Configuración visual
  template      String   @default("classic") // classic, modern, minimal, vibrant
  primaryColor  String   @default("#0d9488")
  accentColor   String   @default("#d97706")
  // Contenido editable
  heroTitle     String?
  heroSubtitle  String?
  heroImageUrl  String?
  aboutText     String?
  contactEmail  String?
  contactPhone  String?
  contactWhatsapp String?
  contactAddress String?
  // Horarios (JSON: {mon: "9-18", ...})
  businessHours String?
  // Redes sociales
  socialLinks   String?  // JSON {instagram, facebook, tiktok, ...}
  // Productos destacados en el sitio (JSON array de productIds)
  featuredProducts String?
  // SEO
  metaTitle     String?
  metaDescription String?
  // Estado
  published     Boolean  @default(true)
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QRCode {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  code          String   @unique  // código corto ej: ABC123
  targetUrl     String   // URL a la que apunta el QR
  type          String   @default("WEBSITE") // WEBSITE, PRODUCT, PROMO, DIRECTORY
  // Métricas
  scans         Int      @default(0)
  uniqueScans   Int      @default(0)
  lastScanAt    DateTime?
  // Asignación a espacio PubliBags (inversa, sin references)
  adSpaceId     String?
  adSpace       AdSpace?
  // Metadata de escaneos (JSON array: [{date, ip, location, device}])
  scanLogs      String?
  createdAt     DateTime @default(now())
}

model AdEdition {
  id            String   @id @default(cuid())
  name          String   // Ej: "Edición Octubre 2025 - Guayaquil"
  slug          String   @unique
  city          String
  totalSpaces   Int      @default(80)  // espacios 5x5cm por bolsa
  bagSize       String   @default("48x48") // tamaño de la bolsa
  printQuantity Int      @default(500) // cantidad de bolsas a imprimir
  startDate     DateTime
  endDate       DateTime
  status        String   @default("DRAFT") // DRAFT, OPEN, CLOSED, PRINTED
  adSpaces      AdSpace[]
  createdAt     DateTime @default(now())
}

model AdSpace {
  id            String   @id @default(cuid())
  editionId     String
  edition       AdEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  providerId    String?
  provider      Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  buyerId       String?  // usuario que compró el espacio (socio) — links to User
  buyer         User?    @relation("AdSpaceBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName     String?  // nombre del comprador (denormalizado para la edición impresa)
  position      Int      // número de espacio (1-297 para bolso)
  type          String   @default("QR") // QR, IMAGE, LOGO
  imageUrl      String?  // si es IMAGE o LOGO
  qrCodeId      String?  @unique
  qrCode        QRCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  status        String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  price         Float    @default(20)
  reservedAt    DateTime?
  soldAt        DateTime?
  createdAt     DateTime @default(now())
}

// ---------- Site Settings + Banners ----------

model SiteSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  updatedAt     DateTime @updatedAt
}

model Banner {
  id            String   @id @default(cuid())
  title         String
  imageUrl      String?
  videoUrl      String?
  gifUrl        String?
  linkUrl       String?
  placement     String   @default("HOME_MAIN")
  width         Int      @default(1320)
  height        Int      @default(330)
  active        Boolean  @default(true)
  order         Int      @default(0)
  startDate     DateTime @default(now())
  endDate       DateTime?
  clicks        Int      @default(0)
  impressions   Int      @default(0)
  createdAt     DateTime @default(now())
}

model BrandLogo {
  id            String   @id @default(cuid())
  name          String
  logoUrl       String
  linkUrl       String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

// ---------- Cooperativa de Ahorro y Crédito ----------

model CooperativeAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Float    @default(0)
  totalContributed Float   @default(0)
  totalEarned     Float    @default(0)
  totalWithdrawn  Float    @default(0)
  interestRate    Float    @default(5)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  transactions    CooperativeTransaction[]
}

model CooperativeTransaction {
  id              String   @id @default(cuid())
  accountId       String
  account         CooperativeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type            String   // DEPOSIT, INTEREST, COMMISSION_MARKETPLACE, COMMISSION_GRID, WITHDRAWAL, MATERIAL
  amount          Float
  description     String?
  // Para materiales reciclados
  materialType    String?  // ALUMINUM, COPPER, BOTTLE_SMALL, BOTTLE_LARGE
  materialQuantity Float?  // libras o unidades
  materialUnitPrice Float? // precio por unidad
  // Para vincular con grid/orden
  referenceId     String?  // gridSpaceId, orderId, etc.
  status          String   @default("COMPLETED") // COMPLETED, PENDING
  createdAt       DateTime @default(now())
}

model MaterialPrice {
  id              String   @id @default(cuid())
  materialType    String   @unique // ALUMINUM, COPPER, BOTTLE_SMALL, BOTTLE_LARGE
  name            String
  unitPrice       Float
  unit            String   @default("libra") // libra, unidad
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model MaterialInventory {
  id              String   @id @default(cuid())
  materialType    String
  quantity        Float    @default(0)
  unit            String   @default("libra")
  // Para vidrio: se guarda para Reciclarte
  // Para aluminio/cobre: se vende
  location        String?  // bodega
  notes           String?
  updatedAt       DateTime @updatedAt
}

model FinancialReport {
  id              String   @id @default(cuid())
  period          String   // "2025-01" mensual o "2025" anual
  type            String   @default("MONTHLY") // MONTHLY, ANNUAL
  totalIncome     Float    @default(0)
  totalExpenses   Float    @default(0)
  totalCommissionsPaid Float @default(0)
  totalInterestPaid Float  @default(0)
  totalMaterialSales Float @default(0)
  totalArtisanSales Float  @default(0)
  netProfit       Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  message       String
  link          String?
  metadata      String?
  read          Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())
}

// ---------- Grid Publicitario (PubliBags Digital) ----------

model GridCampaign {
  id          String   @id @default(cuid())
  name        String
  year        Int
  status      String   @default("ACTIVE")
  pages       GridPage[]
  createdAt   DateTime @default(now())
}

model GridPage {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    GridCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  month       Int
  monthName   String
  totalSpaces Int      @default(300)
  spaces      GridSpace[]
  createdAt   DateTime @default(now())
}

model GridSpace {
  id            String   @id @default(cuid())
  pageId        String
  page          GridPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  position      Int
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  buyerName     String?
  buyerEmail    String?
  buyerPhone    String?
  qrCode        String?
  qrUrl         String?
  purchasePrice Float    @default(20)
  salePrice     Float?
  status        String   @default("AVAILABLE")
  ownedAt       DateTime?
  soldAt        DateTime?
  soldBy        String?
  reimbursedToOwner Boolean @default(false)
  imageUrl      String?
  websiteSlug   String?
  commissions   GridCommission[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GridCommission {
  id            String   @id @default(cuid())
  spaceId       String
  space         GridSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         Int
  amount        Float    @default(1)
  rate          Float    @default(5)
  status        String   @default("PENDING")
  sourceUserId  String?
  createdAt     DateTime @default(now())
}

model TaskProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanDone      Boolean  @default(false)
  identifyDone  Boolean  @default(false)
  visitWebDone  Boolean  @default(false)
  shareDone     Boolean  @default(false)
  commentDone   Boolean  @default(false)
  photoDone     Boolean  @default(false)
  photoUrl      String?
  completed     Boolean  @default(false)
  completedAt   DateTime?
  rewardClaimed Boolean  @default(false)
  rewardClaimedAt DateTime?
  identifiedCompany String?
  shareUrl      String?
  commentText   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Directorio360 + Álbum de Stickers ----------

model DirectoryEntry {
  id            String   @id @default(cuid())
  providerId    String   @unique
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category      String
  tags          String?
  shortDesc     String?
  featured      Boolean  @default(false)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  viewCount     Int      @default(0)
  visitCount    Int      @default(0)
  status        String   @default("ACTIVE")
  stickers      Sticker[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Sticker {
  id            String   @id @default(cuid())
  directoryEntryId String
  directoryEntry DirectoryEntry @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)
  name          String
  imageUrl      String
  code          String   @unique
  rarity        String   @default("COMMON")
  albumProgress  AlbumProgress[]
  createdAt     DateTime @default(now())
}

model AlbumProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerId     String
  sticker       Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  source        String   @default("QR_SCAN")
  collectedAt   DateTime @default(now())
  @@unique([userId, stickerId])
}

model Raffle {
  id            String   @id @default(cuid())
  name          String
  description   String?
  prize         String
  prizeImageUrl String?
  drawDate      DateTime
  status        String   @default("ACTIVE")
  minStickers   Int      @default(10)
  entries       RaffleEntry[]
  createdAt     DateTime @default(now())
}

model RaffleEntry {
  id            String   @id @default(cuid())
  raffleId      String
  raffle        Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       Int      @default(1)
  winner        Boolean  @default(false)
  enteredAt     DateTime @default(now())
  @@unique([raffleId, userId])
}

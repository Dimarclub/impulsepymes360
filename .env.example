# =============================================================================
# DIMARCLUB - VARIABLES DE ENTORNO PARA PRODUCCIÓN
# =============================================================================
# Copia este archivo a ".env" y completa los valores con tus datos reales.
#
# En Hostinger hPanel → Avanzado → Node.js App → Environment Variables
# =============================================================================

# ----- BASE DE DATOS -----
# SQLite (simple, recomendado para empezar):
# La DB se creará automáticamente en esta ruta. Asegúrate que la carpeta exista y sea escribible.
DATABASE_URL=file:/home/u743469517/domains/dimarclub.com/public_html/db/custom.db

# MySQL (alternativa más robusta, opcional):
# Si prefieres MySQL, crea la DB en hPanel → MySQL Databases y usa esta URL:
# DATABASE_URL=mysql://USUARIO:CONTRASEÑA@localhost:3306/NOMBRE_DB

# ----- NEXTAUTH (AUTENTICACIÓN) -----
# Genera un secret aleatorio con: openssl rand -base64 32
# O usa cualquier string largo y aleatorio (mínimo 32 caracteres)
NEXTAUTH_SECRET=cambia_esto_por_un_secret_aleatorio_de_32_caracteres_minimo
NEXTAUTH_URL=https://dimarclub.com

# ----- APP URL -----
# URL pública de tu sitio
NEXT_PUBLIC_APP_URL=https://dimarclub.com

# ----- WHATSAPP -----
# Número de WhatsApp de la empresa (formato internacional sin +)
WHATSAPP_NUMBER=593992689844

# ----- Z-AI WEB DEV SDK (IA de Dima) -----
# Las claves ya están configuradas en el proyecto, no necesitas cambiarlas
# Pero si necesitas tus propias claves, descomenta estas líneas:
# ZAI_API_KEY=tu_api_key_aqui

# ----- NODE_ENV -----
NODE_ENV=production

# ----- PORT -----
# Puerto en el que escucha la app (Hostinger normalmente usa process.env.PORT)
PORT=3000

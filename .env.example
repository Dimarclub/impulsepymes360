# =============================================================================
# DIMARCLUB - VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL + POSTGRES)
# =============================================================================
# En Vercel: Settings → Environment Variables → añade cada una
# =============================================================================

# ----- BASE DE DATOS (VERCEL POSTGRES) -----
# Después de crear la DB en Vercel → Storage → Postgres, copia la conexión:
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://TU_USUARIO:TU_PASSWORD@TU_HOST/TU_DB?sslmode=require

# ----- NEXTAUTH (AUTENTICACIÓN) -----
# Genera un secret aleatorio (32+ caracteres)
# Puedes generar uno en: https://generate-secret-nextauth.vercel.app/
NEXTAUTH_SECRET=cambia_esto_por_un_secret_aleatorio_de_32_caracteres_minimo
NEXTAUTH_URL=https://dimarclub.com

# ----- APP URL -----
NEXT_PUBLIC_APP_URL=https://dimarclub.com

# ----- WHATSAPP -----
WHATSAPP_NUMBER=593992689844

# ----- NODE ENV -----
NODE_ENV=production
